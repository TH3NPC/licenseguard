# LicenseGuard environment template. Copy to .env and fill in real values.
# NEVER commit a real .env. Only placeholders belong in this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (default): SQLite file, no external service required.
DATABASE_URL="file:./dev.db"
# Production example (change schema.prisma provider to "postgresql"):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/licenseguard?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-bytes"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of this deployment; used to build the SDK <script> snippet.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Chapa payments (Phase H — optional, not required for the core platform)
# ---------------------------------------------------------------------------
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
