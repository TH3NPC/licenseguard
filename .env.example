# ZER environment template. Copy to .env and fill in real values.
# NEVER commit a real .env. Only placeholders belong in this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (default): SQLite file, no external service required.
DATABASE_URL="file:./dev.db"
#
# Production (Supabase Postgres): the build swaps the Prisma provider to
# postgresql automatically. Use Supabase's pooled strings and URL-ENCODE any
# special characters in the password (# -> %23, * -> %2A, @ -> %40, etc.).
#   DATABASE_URL = Transaction pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<ENCODED_PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler (port 5432), used for migrations / db push
#   postgresql://postgres.<ref>:<ENCODED_PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Supabase Auth (login / signup)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
# The publishable/anon key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx_or_anon_jwt"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL; used to build the SDK snippet and the hosted live preview.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Chapa payments (optional, not required for the core platform)
# ---------------------------------------------------------------------------
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
